-- Hàm kiểm tra tường siêu tốc
local function isVisible(targetPart, targetCharacter)
    if not Settings.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, targetCharacter}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true
    
    local rayResult = Workspace:Raycast(origin, direction, rayParams)
    if rayResult then return false end
    return true
end

-- Hàm tìm bộ phận lộ ra gần tâm nhất trong vòng tròn
local function getClosestPartInFOV()
    local bestPart = nil
    local shortestDistance = math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not Settings.TeamCheck or player.Team ~= LocalPlayer.Team then
                local character = player.Character
                if character and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
                    
                    local partsToCheck = {
                        character:FindFirstChild("Head"),
                        character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"),
                        character:FindFirstChild("HumanoidRootPart"),
                        character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftUpperArm"),
                        character:FindFirstChild("Right Arm") or character:FindFirstChild("RightUpperArm"),
                        character:FindFirstChild("Left Leg") or character:FindFirstChild("LeftUpperLeg"),
                        character:FindFirstChild("Right Leg") or character:FindFirstChild("RightUpperLeg")
                    }

                    for _, part in ipairs(partsToCheck) do
                        if part then
                            local screenPoint, onScreen = Camera:WorldToViewportPoint(part.Position)
                            if onScreen and isVisible(part, character) then
                                local partScreenPos = Vector2.new(screenPoint.X, screenPoint.Y)
                                local mouseDist = (partScreenPos - screenCenter).Magnitude
                                
                                if mouseDist <= Settings.FOVRadius and mouseDist < shortestDistance then
                                    shortestDistance = mouseDist
                                    bestPart = part
                                end
                            end
                        end
                    end
                    
                end
            end
        end
    end
    return bestPart
end

-- Hàm kích hoạt súng bắn ngay lập tức (Không qua độ trễ chuột ảo)
local function triggerInstantShoot()
    local character = LocalPlayer.Character
    if not character then return end
    
    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function()
            tool:Activate()
        end)
    end
end

-- Vòng lặp khóa cứng mục tiêu và spam bắn tức thì
RunService:BindToRenderStep("InstantAimAndShoot", Enum.RenderPriority.Camera.Value + 1, function()
    if Settings.AimbotEnabled then
        FOVFrame.Visible = true
        local targetPart = getClosestPartInFOV()
        
        if targetPart then
            -- Khóa cứng góc nhìn vào bộ phận vừa lộ ra
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
            
            -- Vừa lú vào vòng tròn là kích hoạt bắn ngay lập tức
            if Settings.AutoShootEnabled then
                triggerInstantShoot()
            end
        end
    else
        FOVFrame.Visible = false
    end
end)

